{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FiniBench Columnar Benchmark Data Schema",
  "type": "object",
  "required": [
    "columns",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 17,
      "maxItems": 17,
      "description": "Column header names ordered to match row element indexes."
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 17,
        "maxItems": 17,
        "prefixItems": [
          {
            "type": "string",
            "description": "LLM display name, comes from the key in model.json"
          },
          {
            "type": "string",
            "description": "Company / Creator, parsed from vllm serve..."
          },
          {
            "type": "string",
            "description": "Canonical base model path or identifier, parsed from vllm serve"
          },
          {
            "type": "string",
            "description": "KV cache quantization level"
          },
          {
            "type": "integer",
            "minimum": 0,
            "description": "Context length in tokens"
          },
          {
            "type": "number",
            "minimum": 0,
            "description": "Model engine memory requirement in GB: Consumed memory (weights + non-torch) + Peak activation - CUDA Graph memory + 1 full KV context"
          },
          {
            "type": "string",
            "description": "Benchmark execution start timestamp (ISO-8601 or YYYY-MM-DDTHH:MM:SSZ)"
          },
          {
            "type": "string",
            "description": "LLM server"
          },
          {
            "type": "string",
            "description": "Speculative decoding"
          },
          {
            "type": "string",
            "description": "Harness name"
          },
          {
            "type": "string",
            "description": "Harness version"
          },
          {
            "type": "string",
            "enum": [
              "off",
              "low",
              "med",
              "high",
              "max"
            ],
            "description": "Reasoning effort"
          },
          {
            "type": "string",
            "description": "Launch config"
          },
          {
            "type": "number",
            "minimum": 0,
            "description": "Intelligence score"
          },
          {
            "type": "number",
            "minimum": 0,
            "description": "Task speed (tasks/hr)"
          },
          {
            "type": "number",
            "minimum": 0,
            "description": "Intelligence density (tasks/GB)"
          },
          {
            "type": "object",
            "description": "Map of arbitrary evaluated benchmark test suites and their execution metrics",
            "additionalProperties": {
              "type": "object",
              "required": [
                "name",
                "earned_score",
                "max_score",
                "run_time_sec",
                "tokens_in",
                "tokens_out",
                "context_used_pct",
                "trace_id"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Display name of the benchmark test suite (e.g. SWE-bench Lite, LiveCodeBench)."
                },
                "earned_score": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Points earned by the agent."
                },
                "max_score": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Maximum possible points for the test."
                },
                "run_time_sec": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Test execution wall-clock time in seconds."
                },
                "tokens_in": {
                  "type": "integer",
                  "minimum": 0
                },
                "tokens_out": {
                  "type": "integer",
                  "minimum": 0
                },
                "context_used_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Percentage of context window utilized during test execution."
                },
                "trace_id": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}